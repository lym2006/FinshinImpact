[importlinter]
root_packages =
    bootstrap
    core
    data
    services
    adapters
    plugins
    utils
    bot
    exceptions
    skin
    ui
    system
include_external_packages = True

[importlinter:contract:core-zero-deps]
name = core zero external dependencies
type = forbidden
source_modules =
    core
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

# 消费方经 ui 门面取窗，链条穿过 ui 属正常，故只禁直接导入
[importlinter:contract:ui-only-qt]
name = Qt confined to the view layer
type = forbidden
source_modules =
    bootstrap
    plugins
    bot
    adapters
    utils
    exceptions
    services
    core
    skin
    data
    system
forbidden_modules =
    PySide6
allow_indirect_imports = True

# 引擎侧的会话类与中间件基类归适配层，utils 只留平台无关件
[importlinter:contract:utils-engine-free]
name = utils free of the engine package
type = forbidden
source_modules =
    utils
forbidden_modules =
    aiogram

[importlinter:contract:data-adapters-isolation]
name = data and adapters isolation
type = forbidden
source_modules =
    data
forbidden_modules =
    adapters

# layers 只拦向上引用，adapters 在 data 之上时引 data 属合法向下，反向隔离另立一条
[importlinter:contract:adapters-data-isolation]
name = adapters not depending on data
type = forbidden
source_modules =
    adapters
forbidden_modules =
    data

[importlinter:contract:core-layers]
name = core internal layers
type = layers
layers =
    core.contracts
    core.dto
    core.domain

[importlinter:contract:top-level-layers]
name = top-level package dependency layers
type = layers
layers =
    bootstrap
    plugins
    bot
    adapters
    ui
    utils
    exceptions
    services
    data
    core
    skin
    system

# 引导窗在身份码写入前加载，utils 的路径常量导入即按身份码冻结，故禁引
# ui._dialogs 与 ui._windows 同样引 utils，一并禁
[importlinter:contract:guide-pre-profile-safe]
name = guide windows importable before profile code is set
type = forbidden
source_modules =
    ui._guide
forbidden_modules =
    utils
    ui._dialogs
    ui._windows
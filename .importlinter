[importlinter]
root_packages =
    bootstrap
    core
    data
    services
    adapters
    plugins
    utils
    bot
    exceptions
    gui
    skin
    ui
    system
include_external_packages = True

[importlinter:contract:core-zero-deps]
name = core zero external dependencies
type = forbidden
source_modules =
    core
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

[importlinter:contract:system-no-qt]
name = system free of Qt
type = forbidden
source_modules =
    system
forbidden_modules =
    PySide6

[importlinter:contract:data-adapters-isolation]
name = data and adapters isolation
type = forbidden
source_modules =
    data
forbidden_modules =
    adapters

[importlinter:contract:core-layers]
name = core internal layers
type = layers
layers =
    core.contracts
    core.dto
    core.domain

[importlinter:contract:top-level-layers]
name = top-level package dependency layers
type = layers
layers =
    bootstrap
    plugins
    bot
    adapters
    ui
    utils
    exceptions
    services
    core
    skin
    data
    system
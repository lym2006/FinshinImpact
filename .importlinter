[importlinter]
root_packages =
    bootstrap
    core
    finshin_sdk
    data
    services
    adapters
    bundled
    utils
    bot
    exceptions
    skin
    ui
    system
include_external_packages = True

[importlinter:contract:core-zero-deps]
name = core zero external dependencies
type = forbidden
source_modules =
    core
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

# 接口包零第三方，平台框架一旦进来就把两侧都锁死在那个平台上
[importlinter:contract:sdk-zero-deps]
name = sdk zero external dependencies
type = forbidden
source_modules =
    finshin_sdk
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

# 消费方经 ui 门面取窗，链条穿过 ui 属正常，故只禁直接导入
[importlinter:contract:ui-only-qt]
name = Qt confined to the view layer
type = forbidden
source_modules =
    bootstrap
    bundled
    bot
    adapters
    utils
    exceptions
    services
    core
    finshin_sdk
    skin
    data
    system
forbidden_modules =
    PySide6
allow_indirect_imports = True

# 引擎侧的会话类与中间件基类归适配层，utils 只留平台无关件
[importlinter:contract:utils-engine-free]
name = utils free of the engine package
type = forbidden
source_modules =
    utils
forbidden_modules =
    aiogram

# 本体只认接口包与归一事件，链条穿过 adapters 属正常，故只禁直接导入
[importlinter:contract:body-aiogram-free]
name = body free of the platform engine
type = forbidden
source_modules =
    bootstrap
    bundled
    bot
    core
    data
    exceptions
    services
    skin
    system
    ui
    utils
forbidden_modules =
    aiogram
allow_indirect_imports = True

[importlinter:contract:data-adapters-isolation]
name = data and adapters isolation
type = forbidden
source_modules =
    data
forbidden_modules =
    adapters

# layers 只拦向上引用，adapters 在 data 之上时引 data 属合法向下，反向隔离另立一条
[importlinter:contract:adapters-data-isolation]
name = adapters not depending on data
type = forbidden
source_modules =
    adapters
forbidden_modules =
    data

[importlinter:contract:sdk-layers]
name = sdk internal layers
type = layers
layers =
    finshin_sdk._assembly
    finshin_sdk._context
    finshin_sdk._adapter
    finshin_sdk.dto
    finshin_sdk.domain

[importlinter:contract:top-level-layers]
name = top-level package dependency layers
type = layers
layers =
    bootstrap
    bundled
    bot
    adapters
    ui
    utils
    exceptions
    services
    data
    core
    finshin_sdk
    skin
    system

# 引擎侧只按平台标识取装配件，取件链条穿过装载门面属正常，故只禁直接导入
[importlinter:contract:bot-platform-neutral]
name = bot pieces stay platform neutral
type = forbidden
source_modules =
    bot._managers
    bot._main
    bot._service
forbidden_modules =
    adapters
allow_indirect_imports = True

# 引导窗在身份码写入前加载，utils 的路径常量导入即按身份码冻结，故禁引
# ui._dialogs 与 ui._windows 同样引 utils，一并禁
[importlinter:contract:guide-pre-profile-safe]
name = guide windows importable before profile code is set
type = forbidden
source_modules =
    ui._guide
forbidden_modules =
    utils
    ui._dialogs
    ui._windows
[importlinter]
root_packages =
    bootstrap
    core
    finshin_sdk
    data
    services
    bundled
    utils
    bot
    exceptions
    skin
    ui
    system
include_external_packages = True

# core 不许引任何第三方库
[importlinter:contract:core-zero-deps]
name = core zero external dependencies
type = forbidden
source_modules =
    core
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

# 接口包 finshin_sdk 不许引任何第三方库
[importlinter:contract:sdk-zero-deps]
name = sdk zero external dependencies
type = forbidden
source_modules =
    finshin_sdk
forbidden_modules =
    aiogram
    PySide6
    aiosqlite
    httpx
    playwright
    tenacity
    markdown
    PIL
    cv2
    numpy

# 除 ui 之外各层不许直接引 PySide6
[importlinter:contract:ui-only-qt]
name = Qt confined to the view layer
type = forbidden
source_modules =
    bootstrap
    bundled
    bot
    utils
    exceptions
    services
    core
    finshin_sdk
    skin
    data
    system
forbidden_modules =
    PySide6
allow_indirect_imports = True

# utils 不许引 aiogram
[importlinter:contract:utils-engine-free]
name = utils free of the engine package
type = forbidden
source_modules =
    utils
forbidden_modules =
    aiogram

# 本体各层不许直接引 aiogram
[importlinter:contract:body-aiogram-free]
name = body free of the platform engine
type = forbidden
source_modules =
    bootstrap
    bundled
    bot
    core
    data
    exceptions
    services
    skin
    system
    ui
    utils
forbidden_modules =
    aiogram
allow_indirect_imports = True

# 接口包内部各段只能上层引下层
[importlinter:contract:sdk-layers]
name = sdk internal layers
type = layers
layers =
    finshin_sdk.exceptions
    finshin_sdk._assembly
    finshin_sdk._context
    finshin_sdk._capability
    finshin_sdk._adapter
    finshin_sdk._log
    finshin_sdk._link
    finshin_sdk.dto
    finshin_sdk.domain

# 顶层包之间只能上层引下层
[importlinter:contract:top-level-layers]
name = top-level package dependency layers
type = layers
layers =
    bootstrap
    bundled
    bot
    ui
    services
    utils
    exceptions
    data
    core
    finshin_sdk
    skin
    system

# 引导窗那一段不许直接引 utils 与其他界面层
# 引导段取数与装卸一律经 services 那侧
[importlinter:contract:guide-pre-profile-safe]
name = guide windows importable before profile code is set
type = forbidden
source_modules =
    ui._guide
forbidden_modules =
    utils
    ui._dialogs
    ui._windows
allow_indirect_imports = True

# 下层只取件，不许引编排类
[importlinter:contract:orchestration-out-of-lower-layers]
name = orchestration stays out of the lower layers
type = forbidden
source_modules =
    services
    data
    core
forbidden_modules =
    utils.check
    utils.plugin
    utils.config
    utils.middleware
